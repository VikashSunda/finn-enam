# Optional. Enables evidence-grounded synthesis; excerpts work without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Alternatively use OpenAI; Gemini takes precedence when both are configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Ordered backups after temporary provider/model failures; at most 3 models total.
# Set to an empty value to disable fallback. No billing settings are changed.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
